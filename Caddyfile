# Gateway de production : seul conteneur publie sur 80 et 443 du VPS. Elle sert
# le site et porte aussi l'entree de l'environnement dev (bloc en bas).
#
# Les regles de service (compression, en-tetes, diagnostics, routage /api/uX)
# vivent dans caddy/routes.caddy, partage avec la dev. Ce fichier ne garde que
# ce qui est propre a la production : les noms de domaine et la porte de la dev.

# Redirection du www vers le domaine nu, en 301.
# Les deux hotes servaient jusqu'ici la meme page en 200 : les balises
# <link rel="canonical"> pointent toutes vers l'apex, donc Google finissait par
# choisir la bonne URL, mais chaque page etait crawlee deux fois. Sur un domaine
# jeune au budget de crawl reduit, c'est du gaspillage evitable.
www.citatio-geo.com {
    redir https://citatio-geo.com{uri} permanent
}

citatio-geo.com {
    import routes.caddy
}

# Environnement dev, deploye par la CI a chaque commit de PR et a chaque push
# sur develop. Deux gateways ne peuvent pas ecouter sur 443 : la production
# termine le TLS et relaie vers la gateway de la dev, seul conteneur dev relie a
# celle-ci, par le reseau citatio-edge. Les autres conteneurs dev restent sur
# leur propre reseau : s'ils rejoignaient celui de la production, un nom comme
# `frontend` pourrait s'y resoudre vers le conteneur dev.
#
# L'authentification et le noindex sont poses ici, cote production, et non dans
# Caddyfile.dev : une PR ne peut donc pas les retirer de la dev en modifiant sa
# propre configuration, puisque ce fichier n'est applique qu'au deploiement de
# production.
dev.citatio-geo.com {
    # Le hash bcrypt vient de .env.gateway, ecrit par le deploiement de production
    # depuis le secret DEV_AUTH_HASH. La valeur par defaut est le hash d'une chaine
    # aleatoire jetee a sa creation : sans secret (pile locale), la dev reste
    # fermee au lieu de s'ouvrir, et Caddy demarre quand meme.
    basic_auth {
        citatio {$DEV_AUTH_HASH:$2a$14$nCPZWQKfLWuRJQ3YrvUpUO8J00A4LS1G/SgH8BgI87HN8Nh02wuUO}
    }

    # Consigne aux moteurs de ne rien indexer. L'authentification suffit
    # aujourd'hui ; l'en-tete protege du jour ou elle sauterait par erreur, sans
    # quoi la dev ferait doublon avec le site et lui volerait son referencement.
    header X-Robots-Tag "noindex, nofollow"

    # Resolu a chaque connexion : si la dev est arretee ou en cours de
    # deploiement, seul ce domaine repond 502, la production n'est pas touchee.
    reverse_proxy citatio-dev-gateway:80
}

# CRM interne de l'agence (depot citatio-crm), deploye a part dans
# /opt/citatio-crm. La gateway de production le joint par le reseau
# citatio-crm-edge ; resolu a chaque connexion : CRM arrete ou en cours de
# deploiement, seul ce domaine repond 502.
crm.citatio-geo.com {
    encode zstd gzip

    # Pas de routes.caddy ici : ses regles (diagnostics /api/uX, routage) sont
    # celles du site. En-tetes de securite repris, cadre interdit, et noindex :
    # l'ecran de connexion n'a rien a faire dans les resultats de recherche.
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        X-Robots-Tag "noindex, nofollow"
        -Server
    }

    # Pieces jointes limitees a 20 Mo par le CRM (MAX_UPLOAD_MB) : marge pour
    # l'encodage multipart, refus en 413 au-dela sans rien transmettre.
    request_body {
        max_size 25MB
    }

    reverse_proxy citatio-crm-app:3000
}
