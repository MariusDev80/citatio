<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.citatio</groupId>
		<artifactId>backend</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>common-libs</artifactId>
	<name>common-libs</name>
	<description>DTOs et configuration partagees entre microservices (aucune logique metier, aucun acces DB).</description>

	<dependencies>
		<!-- Web MVC en 'optional' : necessaire pour compiler la config CORS partagee,
		     le client REST inter-modules et le handler d'erreurs RFC 7807,
		     mais ce sont les modules applicatifs qui l'apportent reellement au runtime. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Disjoncteur des appels inter-modules. On prend le module coeur, en Java nu :
		     le starter resilience4j-spring-boot3 vise Boot 3 / Spring 6, alors que le
		     projet est sur Boot 4 / Spring 7. Voir UpstreamCircuitBreakers. -->
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-circuitbreaker</artifactId>
			<version>${resilience4j.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!-- Jar simple : PAS de spring-boot-maven-plugin (ce n'est pas une application executable). -->

</project>
