<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.8</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.citatio</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>backend</name>
	<description>Citatio backend, aggregateur multi-modules (microservices)</description>

	<!-- Chaque microservice est un module Maven autonome, buildable et testable independamment. -->
	<modules>
		<module>common-libs</module>
		<module>u1-communication</module>
		<module>u2-blog</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<!-- Pas gere par le BOM Spring Boot : la version est fixee ici pour que les
		     trois modules partagent la meme. -->
		<resilience4j.version>2.3.0</resilience4j.version>
		<tomcat.version>11.0.25</tomcat.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- DTOs / config partages : reference sans version dans les modules. -->
			<dependency>
				<groupId>com.citatio</groupId>
				<artifactId>common-libs</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<!-- pluginManagement : les modules heritent de la config sans la redeclarer. -->
		<pluginManagement>
			<plugins>
				<!-- Lombok comme annotation processor (applique a tous les modules). -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
				<!-- Repackaging Spring Boot : seuls les modules applicatifs declarent ce plugin. -->
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
					<configuration>
						<excludes>
							<exclude>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
							</exclude>
						</excludes>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>
